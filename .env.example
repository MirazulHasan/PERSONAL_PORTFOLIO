# Required for all environments
# For Neon / Postgres (Production)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# For Local development (SQLite, optional if you switch schema provider)
# DATABASE_URL="file:./dev.db"

# NextAuth – generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="supersecret1234567890qwertyuiop"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
